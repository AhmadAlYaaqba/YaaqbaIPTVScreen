# Inlined into the JS bundle at build time by babel-preset-expo (EXPO_PUBLIC_ prefix).
# Never put secrets here: the TMDB API key is entered in Settings at runtime and
# stored in the device Keychain.
EXPO_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
EXPO_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
# Set to 1 to show the in-player stream debug overlay in dev builds.
EXPO_PUBLIC_STREAM_DEBUG=0
