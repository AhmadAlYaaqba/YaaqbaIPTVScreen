+// TV only: the ScrollView is wrapped in a TVFocusGuideView that had no layout
+// style, so it shrank to its 1x1 minimum and a `flex: 1` list collapsed to ~2px.
+// Mirror Android's RefreshControl wrapper: the guide takes the list's outer
+// layout props and the ScrollView (flexGrow/flexShrink by default) fills it.
+const TV_OUTER_LAYOUT_PROPS = new Set([
+  'margin',
+  'marginHorizontal',
+  'marginVertical',
+  'marginBottom',
+  'marginTop',
+  'marginLeft',
+  'marginRight',
+  'flex',
+  'flexGrow',
+  'flexShrink',
+  'flexBasis',
+  'alignSelf',
+  'height',
+  'minHeight',
+  'maxHeight',
+  'width',
+  'minWidth',
+  'maxWidth',
+  'position',
+  'left',
+  'right',
+  'bottom',
+  'top',
+  'transform',
+  'transformOrigin',
+]);
+const TV_FOCUS_GUIDE_FILL = {flexGrow: 1, flexShrink: 1};
+
+function splitTVListStyle(style: any): {outer: any, inner: any} {
+  const flat = StyleSheet.flatten(style);
+  if (flat == null) {
+    return {outer: null, inner: null};
+  }
+  const outer: {[string]: mixed} = {};
+  const inner: {[string]: mixed} = {};
+  for (const key of Object.keys(flat)) {
+    if (TV_OUTER_LAYOUT_PROPS.has(key)) {
+      outer[key] = flat[key];
+    } else {
+      inner[key] = flat[key];
+    }
+  }
+  return {outer, inner};
+}
